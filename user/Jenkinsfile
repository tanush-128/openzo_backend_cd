node {
    def app

    stage('Clone repository') {
      

        checkout scm
    }

    stage('Update GIT') {
            script {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    withCredentials([usernamePassword(credentialsId: 'github', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                        //def encodedPassword = URLEncoder.encode("$GIT_PASSWORD",'UTF-8')
                        sh "git config user.email tanush@myyahoo.com"
                        sh "git config user.name tanush-128"
                        //sh "git switch master"
                        sh "cat user/deployment.yml"
                        sh "sed -i 's+tanush128/user.*+tanush128/user:${DOCKERTAG}+g' user/deployment.yml"
                        sh "cat user/deployment.yaml"
                        sh "git add ."
                        sh "git commit -m 'Done by Jenkins Job changemanifest: ${env.BUILD_NUMBER}'"
                        sh "git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/${GIT_USERNAME}/openzo_backend_cd.git HEAD:main"
      }
    }
  }
}
}